VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# Optional strict couple mode:
# - Leave disabled for open multi-user signup
# - Enable only if you want to whitelist specific emails
VITE_STRICT_COUPLE_MODE=false
VITE_ALLOWED_USERS=partner1@example.com,partner2@example.com

# Admin emails (comma-separated)
VITE_ADMIN_EMAILS=gekansh2008@gmail.com
