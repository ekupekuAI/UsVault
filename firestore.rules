rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.email in [
        "gekansh2008@gmail.com"
      ];
    }

    function isMutuallyLinkedWith(userId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/statuses/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/statuses/$(userId)) &&
        get(/databases/$(database)/documents/statuses/$(request.auth.uid)).data.partnerUid == userId &&
        get(/databases/$(database)/documents/statuses/$(userId)).data.partnerUid == request.auth.uid;
    }

    match /users/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin() || isMutuallyLinkedWith(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    match /statuses/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_controls/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.banned == false &&
        request.resource.data.canUseApp == true;
      allow create, update, delete: if isAdmin();
    }

    match /push_tokens/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
