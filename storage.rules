rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminByClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAdminByEmail() {
      return signedIn() && request.auth.token.email in [
        'gekansh2008@gmail.com'
      ];
    }

    function isAdmin() {
      return isAdminByClaim() || isAdminByEmail();
    }

    function isValidImageWrite() {
      return request.resource == null ||
        (
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')
        );
    }

    match /journal/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidImageWrite();
    }

    match /profiles/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidImageWrite();
    }
  }
}
